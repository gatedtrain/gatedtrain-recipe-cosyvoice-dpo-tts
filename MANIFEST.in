# The source distribution holds the package, its metadata and the legal files. The tests, their fixtures, the runtime
# (scripts, locks, item sets), the launch files and the published results stay in the repository.
include LICENSE NOTICE THIRD_PARTY_NOTICES.md README.md pyproject.toml
prune tests
prune runtime
prune launch
prune results
global-exclude __pycache__ *.py[cod] .DS_Store
